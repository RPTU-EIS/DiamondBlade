module DB_AIP_fw_cycle4(clk, reset_n);
input clk;
input reset_n;


function automatic blackboxing();
	blackboxing = 1'b1;
endfunction

function automatic threat_model_global();
	threat_model_global = 1'b1;
endfunction

function automatic threat_model_start();
	threat_model_start = 1'b1;
endfunction

function automatic invariants();
	invariants =
		(DUV1.key_reg != 512'b0) && (DUV2.key_reg != 512'b0) &&
		(DUV1.key_reg[15:12] != 128'b0) && (DUV2.key_reg[15:12] != 128'b0);
endfunction

invariant_assumption: assume property(@(posedge clk) disable iff(reset_n==0) invariants());


//System Verilog library for TiDAL
`include "tidal.sv"

//TiDAL properties must be enclosed within begin_tda and end_tda macros
`begin_tda(tda)

function automatic input_equivalence_except_src();
	input_equivalence_except_src = (
		(DUV1.address == DUV2.address) &&
		(DUV1.clk == DUV2.clk) &&
		(DUV1.cptra_pwrgood == DUV2.cptra_pwrgood) &&
		(DUV1.cs == DUV2.cs) &&
		(DUV1.debugUnlock_or_scan_mode_switch == DUV2.debugUnlock_or_scan_mode_switch) &&
		(DUV1.kv_rd_resp == DUV2.kv_rd_resp) &&
		(DUV1.kv_wr_resp == DUV2.kv_wr_resp) &&
		(DUV1.reset_n == DUV2.reset_n) &&
		(DUV1.we == DUV2.we) &&
		(DUV1.write_data == DUV2.write_data)
	);
endfunction


function automatic state_equivalence_except_src();
