property DiamondBlade_forward_core$u_sha512_core_h1$H1_reg_cycle4;

	during_o(t, 0, t, 4, blackboxing()) and
	t ##0 state_equivalence_except_src() and
	during_o(t, 0, t, 4, input_equivalence_except_src()) and
	during_o(t, 0, t, 4, threat_model_global()) and
	t ##0 threat_model_start()

implies

	t ##4 DUV1.core.u_sha512_core_h1.H1_reg == DUV2.core.u_sha512_core_h1.H1_reg;

endproperty

