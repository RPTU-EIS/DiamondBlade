module DB_AIP_Step(clk, reset_n);
input clk;
input reset_n;


function automatic blackboxing();
	blackboxing = 1'b1;
endfunction

function automatic threat_model_global();
	threat_model_global = 1'b1;
endfunction

function automatic threat_model_start();
	threat_model_start = 1'b1;
endfunction

function automatic invariants();
	invariants =
		!
		(
			//key_zero_error
			(DUV1.cptra_csr_hmac_key[0] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[1] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[2] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[3] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[4] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[5] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[6] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[7] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[8] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[9] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[10] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[11] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[12] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[13] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[14] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[15] == 32'b0)
			||
			(DUV2.cptra_csr_hmac_key[0] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[1] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[2] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[3] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[4] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[5] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[6] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[7] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[8] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[9] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[10] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[11] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[12] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[13] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[14] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[15] == 32'b0)
			||
			//key_mode_error
			(DUV1.cptra_csr_hmac_key[12] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[13] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[14] == 32'b0) &&
			(DUV1.cptra_csr_hmac_key[15] == 32'b0)
			||
			(DUV2.cptra_csr_hmac_key[12] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[13] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[14] == 32'b0) &&
			(DUV2.cptra_csr_hmac_key[15] == 32'b0)
		);
endfunction

invariant_assumption: assume property(@(posedge clk) disable iff(reset_n==0) invariants());


function automatic input_equivalence_except_src();
	input_equivalence_except_src = (
		(DUV1.address == DUV2.address) &&
		(DUV1.clk == DUV2.clk) &&
		(DUV1.cptra_pwrgood == DUV2.cptra_pwrgood) &&
		(DUV1.cs == DUV2.cs) &&
		(DUV1.debugUnlock_or_scan_mode_switch == DUV2.debugUnlock_or_scan_mode_switch) &&
		(DUV1.kv_rd_resp == DUV2.kv_rd_resp) &&
		(DUV1.kv_wr_resp == DUV2.kv_wr_resp) &&
		(DUV1.reset_n == DUV2.reset_n) &&
		(DUV1.we == DUV2.we) &&
		(DUV1.write_data == DUV2.write_data)
	);
endfunction


function automatic state_equivalence_step();
	state_equivalence_step = (
		(DUV1.block_reg_lock == DUV2.block_reg_lock) &&
		(DUV1.error_flag_reg == DUV2.error_flag_reg) &&
		(DUV1.key_mode_error_reg == DUV2.key_mode_error_reg) &&
		(DUV1.key_zero_error_reg == DUV2.key_zero_error_reg) &&
		(DUV1.kv_data_present == DUV2.kv_data_present) &&
		(DUV1.kv_key_data_present == DUV2.kv_key_data_present) &&
		(DUV1.kv_reg == DUV2.kv_reg) &&
		(DUV1.ready_reg == DUV2.ready_reg) &&
		(DUV1.tag_valid_reg == DUV2.tag_valid_reg) &&
		(DUV1.core.digest_valid_reg == DUV2.core.digest_valid_reg) &&
		(DUV1.core.hmac_ctrl_last == DUV2.core.hmac_ctrl_last) &&
		(DUV1.core.hmac_ctrl_reg == DUV2.core.hmac_ctrl_reg) &&
		(DUV1.core.mode_reg == DUV2.core.mode_reg) &&
		(DUV1.core.u_sha512_core_h1.digest_valid_reg == DUV2.core.u_sha512_core_h1.digest_valid_reg) &&
		(DUV1.core.u_sha512_core_h1.init_reg == DUV2.core.u_sha512_core_h1.init_reg) &&
		(DUV1.core.u_sha512_core_h1.masking_rnd == DUV2.core.u_sha512_core_h1.masking_rnd) &&
		(DUV1.core.u_sha512_core_h1.ready_reg == DUV2.core.u_sha512_core_h1.ready_reg) &&
		(DUV1.core.u_sha512_core_h1.rnd_ctr_reg == DUV2.core.u_sha512_core_h1.rnd_ctr_reg) &&
		(DUV1.core.u_sha512_core_h1.round_ctr_reg == DUV2.core.u_sha512_core_h1.round_ctr_reg) &&
		(DUV1.core.u_sha512_core_h1.sha512_ctrl_reg == DUV2.core.u_sha512_core_h1.sha512_ctrl_reg) &&
		(DUV1.core.u_sha512_core_h1.w_mem_inst.w_ctr_reg == DUV2.core.u_sha512_core_h1.w_mem_inst.w_ctr_reg) &&
		(DUV1.core.u_sha512_core_h2.digest_valid_reg == DUV2.core.u_sha512_core_h2.digest_valid_reg) &&
		(DUV1.core.u_sha512_core_h2.init_reg == DUV2.core.u_sha512_core_h2.init_reg) &&
		(DUV1.core.u_sha512_core_h2.masking_rnd == DUV2.core.u_sha512_core_h2.masking_rnd) &&
		(DUV1.core.u_sha512_core_h2.ready_reg == DUV2.core.u_sha512_core_h2.ready_reg) &&
		(DUV1.core.u_sha512_core_h2.rnd_ctr_reg == DUV2.core.u_sha512_core_h2.rnd_ctr_reg) &&
		(DUV1.core.u_sha512_core_h2.round_ctr_reg == DUV2.core.u_sha512_core_h2.round_ctr_reg) &&
		(DUV1.core.u_sha512_core_h2.sha512_ctrl_reg == DUV2.core.u_sha512_core_h2.sha512_ctrl_reg) &&
		(DUV1.core.u_sha512_core_h2.w_mem_inst.w_ctr_reg == DUV2.core.u_sha512_core_h2.w_mem_inst.w_ctr_reg) &&
		(DUV1.core.gen_lfsr[0].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[0].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[0].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[0].lfsr_inst_i.rnd_reg) &&
		(DUV1.core.gen_lfsr[1].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[1].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[1].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[1].lfsr_inst_i.rnd_reg) &&
		(DUV1.core.gen_lfsr[2].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[2].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[2].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[2].lfsr_inst_i.rnd_reg) &&
		(DUV1.core.gen_lfsr[3].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[3].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[3].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[3].lfsr_inst_i.rnd_reg) &&
		(DUV1.core.gen_lfsr[4].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[4].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[4].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[4].lfsr_inst_i.rnd_reg) &&
		(DUV1.core.gen_lfsr[5].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[5].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[5].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[5].lfsr_inst_i.rnd_reg) &&
		(DUV1.core.gen_lfsr[6].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[6].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[6].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[6].lfsr_inst_i.rnd_reg) &&
		(DUV1.core.gen_lfsr[7].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[7].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[7].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[7].lfsr_inst_i.rnd_reg) &&
		(DUV1.core.gen_lfsr[8].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[8].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[8].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[8].lfsr_inst_i.rnd_reg) &&
		(DUV1.core.gen_lfsr[9].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[9].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[9].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[9].lfsr_inst_i.rnd_reg) &&
		(DUV1.core.gen_lfsr[10].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[10].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[10].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[10].lfsr_inst_i.rnd_reg) &&
		(DUV1.core.gen_lfsr[11].lfsr_inst_i.counter_reg == DUV2.core.gen_lfsr[11].lfsr_inst_i.counter_reg) &&
		(DUV1.core.gen_lfsr[11].lfsr_inst_i.rnd_reg == DUV2.core.gen_lfsr[11].lfsr_inst_i.rnd_reg) &&
		(DUV1.hmac_block_kv_read.error_code == DUV2.hmac_block_kv_read.error_code) &&
		(DUV1.hmac_block_kv_read.kv_read_fsm.kv_fsm_ps == DUV2.hmac_block_kv_read.kv_read_fsm.kv_fsm_ps) &&
		(DUV1.hmac_block_kv_read.kv_read_fsm.num_dwords_data == DUV2.hmac_block_kv_read.kv_read_fsm.num_dwords_data) &&
		(DUV1.hmac_block_kv_read.kv_read_fsm.offset == DUV2.hmac_block_kv_read.kv_read_fsm.offset) &&
		(DUV1.hmac_key_kv_read.error_code == DUV2.hmac_key_kv_read.error_code) &&
		(DUV1.hmac_key_kv_read.kv_read_fsm.kv_fsm_ps == DUV2.hmac_key_kv_read.kv_read_fsm.kv_fsm_ps) &&
		(DUV1.hmac_key_kv_read.kv_read_fsm.offset == DUV2.hmac_key_kv_read.kv_read_fsm.offset) &&
		(DUV1.hmac_result_kv_write.error_code == DUV2.hmac_result_kv_write.error_code) &&
		(DUV1.hmac_result_kv_write.kv_dest_write_fsm.kv_fsm_ps == DUV2.hmac_result_kv_write.kv_dest_write_fsm.kv_fsm_ps) &&
		(DUV1.hmac_result_kv_write.kv_dest_write_fsm.offset == DUV2.hmac_result_kv_write.kv_dest_write_fsm.offset) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_CTRL == DUV2.i_hmac_reg.field_storage.HMAC512_CTRL) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KEY == DUV2.i_hmac_reg.field_storage.HMAC512_KEY) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_BLOCK == DUV2.i_hmac_reg.field_storage.HMAC512_BLOCK) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_LFSR_SEED == DUV2.i_hmac_reg.field_storage.HMAC512_LFSR_SEED) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_RD_KEY_CTRL == DUV2.i_hmac_reg.field_storage.HMAC512_KV_RD_KEY_CTRL) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_RD_KEY_STATUS == DUV2.i_hmac_reg.field_storage.HMAC512_KV_RD_KEY_STATUS) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_RD_BLOCK_CTRL == DUV2.i_hmac_reg.field_storage.HMAC512_KV_RD_BLOCK_CTRL) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_RD_BLOCK_STATUS == DUV2.i_hmac_reg.field_storage.HMAC512_KV_RD_BLOCK_STATUS) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_WR_CTRL == DUV2.i_hmac_reg.field_storage.HMAC512_KV_WR_CTRL) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_WR_STATUS == DUV2.i_hmac_reg.field_storage.HMAC512_KV_WR_STATUS) &&
		(DUV1.i_hmac_reg.field_storage.intr_block_rf == DUV2.i_hmac_reg.field_storage.intr_block_rf)
	);
endfunction


function automatic V_step_equivalence();
	V_step_equivalence = (
		(DUV1.key_mode_error_reg == DUV2.key_mode_error_reg) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_CTRL == DUV2.i_hmac_reg.field_storage.HMAC512_CTRL) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KEY == DUV2.i_hmac_reg.field_storage.HMAC512_KEY) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_BLOCK == DUV2.i_hmac_reg.field_storage.HMAC512_BLOCK) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_LFSR_SEED == DUV2.i_hmac_reg.field_storage.HMAC512_LFSR_SEED) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_RD_KEY_CTRL == DUV2.i_hmac_reg.field_storage.HMAC512_KV_RD_KEY_CTRL) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_RD_KEY_STATUS == DUV2.i_hmac_reg.field_storage.HMAC512_KV_RD_KEY_STATUS) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_RD_BLOCK_CTRL == DUV2.i_hmac_reg.field_storage.HMAC512_KV_RD_BLOCK_CTRL) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_RD_BLOCK_STATUS == DUV2.i_hmac_reg.field_storage.HMAC512_KV_RD_BLOCK_STATUS) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_WR_CTRL == DUV2.i_hmac_reg.field_storage.HMAC512_KV_WR_CTRL) &&
		(DUV1.i_hmac_reg.field_storage.HMAC512_KV_WR_STATUS == DUV2.i_hmac_reg.field_storage.HMAC512_KV_WR_STATUS) &&
		(DUV1.i_hmac_reg.field_storage.intr_block_rf == DUV2.i_hmac_reg.field_storage.intr_block_rf) &&
		(DUV1.error_flag_reg == DUV2.error_flag_reg) &&
		(DUV1.key_zero_error_reg == DUV2.key_zero_error_reg)
	);
endfunction


//System Verilog library for TiDAL
`include "tidal.sv"

//TiDAL properties must be enclosed within begin_tda and end_tda macros
`begin_tda(tda)

property DiamondBlade_Step;

	during_o(t, 0, t, 2, blackboxing()) and
	during_o(t, 0, t, 1, state_equivalence_step()) and
	during_o(t, 0, t, 2, input_equivalence_except_src()) and
	during_o(t, 0, t, 2, threat_model_global()) and
	t ##0 threat_model_start()

implies

	t ##2 V_step_equivalence();

endproperty

DiamondBlade_Step_prop: assert property (@(posedge clk) disable iff (reset_n==0) DiamondBlade_Step);

`end_tda
endmodule


//Bind assertion module to DUV
bind miter DB_AIP_Step inst_DB_AIP_Step(.clk(clk), .reset_n(reset_n));

