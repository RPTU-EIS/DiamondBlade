		DUV1.frontend.bpd.banked_predictors_0.io_resp_f3_3_predicted_pc_bits == DUV2.frontend.bpd.banked_predictors_0.io_resp_f3_3_predicted_pc_bits &&
		DUV1.frontend.bpd.banked_predictors_0.io_resp_f3_3_predicted_pc_valid == DUV2.frontend.bpd.banked_predictors_0.io_resp_f3_3_predicted_pc_valid &&
		DUV1.frontend.bpd.banked_predictors_0.io_resp_f3_3_taken == DUV2.frontend.bpd.banked_predictors_0.io_resp_f3_3_taken
	);
endfunction
