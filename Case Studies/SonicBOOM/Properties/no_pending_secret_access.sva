		(DUV1.lsu.ldq_7_valid && !DUV1.lsu.ldq_7_bits_addr_is_virtual ? DUV1.lsu.ldq_7_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.ldq_8_valid && !DUV1.lsu.ldq_8_bits_addr_is_virtual ? DUV1.lsu.ldq_8_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.ldq_9_valid && !DUV1.lsu.ldq_9_bits_addr_is_virtual ? DUV1.lsu.ldq_9_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.ldq_10_valid && !DUV1.lsu.ldq_10_bits_addr_is_virtual ? DUV1.lsu.ldq_10_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
