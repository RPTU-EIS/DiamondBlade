function automatic no_secret_load_translated();
	no_secret_load_translated = (
		(DUV1.lsu.ldq_0_valid && !DUV1.lsu.ldq_0_bits_addr_is_virtual ? DUV1.lsu.ldq_0_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.ldq_1_valid && !DUV1.lsu.ldq_1_bits_addr_is_virtual ? DUV1.lsu.ldq_1_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
