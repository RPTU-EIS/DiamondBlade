		(DUV1.lsu.ldq_12_valid && !DUV1.lsu.ldq_12_bits_addr_is_virtual ? DUV1.lsu.ldq_12_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.ldq_13_valid && !DUV1.lsu.ldq_13_bits_addr_is_virtual ? DUV1.lsu.ldq_13_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.ldq_14_valid && !DUV1.lsu.ldq_14_bits_addr_is_virtual ? DUV1.lsu.ldq_14_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.ldq_15_valid && !DUV1.lsu.ldq_15_bits_addr_is_virtual ? DUV1.lsu.ldq_15_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_0_valid && !DUV2.lsu.ldq_0_bits_addr_is_virtual ? DUV2.lsu.ldq_0_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_1_valid && !DUV2.lsu.ldq_1_bits_addr_is_virtual ? DUV2.lsu.ldq_1_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_2_valid && !DUV2.lsu.ldq_2_bits_addr_is_virtual ? DUV2.lsu.ldq_2_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_3_valid && !DUV2.lsu.ldq_3_bits_addr_is_virtual ? DUV2.lsu.ldq_3_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_4_valid && !DUV2.lsu.ldq_4_bits_addr_is_virtual ? DUV2.lsu.ldq_4_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_5_valid && !DUV2.lsu.ldq_5_bits_addr_is_virtual ? DUV2.lsu.ldq_5_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_6_valid && !DUV2.lsu.ldq_6_bits_addr_is_virtual ? DUV2.lsu.ldq_6_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_7_valid && !DUV2.lsu.ldq_7_bits_addr_is_virtual ? DUV2.lsu.ldq_7_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_8_valid && !DUV2.lsu.ldq_8_bits_addr_is_virtual ? DUV2.lsu.ldq_8_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_9_valid && !DUV2.lsu.ldq_9_bits_addr_is_virtual ? DUV2.lsu.ldq_9_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_10_valid && !DUV2.lsu.ldq_10_bits_addr_is_virtual ? DUV2.lsu.ldq_10_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_11_valid && !DUV2.lsu.ldq_11_bits_addr_is_virtual ? DUV2.lsu.ldq_11_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_12_valid && !DUV2.lsu.ldq_12_bits_addr_is_virtual ? DUV2.lsu.ldq_12_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_13_valid && !DUV2.lsu.ldq_13_bits_addr_is_virtual ? DUV2.lsu.ldq_13_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_14_valid && !DUV2.lsu.ldq_14_bits_addr_is_virtual ? DUV2.lsu.ldq_14_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.ldq_15_valid && !DUV2.lsu.ldq_15_bits_addr_is_virtual ? DUV2.lsu.ldq_15_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1)
	);
endfunction

function automatic no_pending_secret_replay();
	no_pending_secret_replay = (
		(DUV1.dcache.mshrs.mshrs_0.req_addr[31:12] != miter.SECRET_TAG) &&
		(DUV1.dcache.mshrs.mshrs_1.req_addr[31:12] != miter.SECRET_TAG) &&
		(DUV2.dcache.mshrs.mshrs_0.req_addr[31:12] != miter.SECRET_TAG) &&
		(DUV2.dcache.mshrs.mshrs_1.req_addr[31:12] != miter.SECRET_TAG)
	);
endfunction

function automatic no_pending_secret_writeback();
	no_pending_secret_writeback = (
		(DUV1.dcache.wb.req_tag != miter.SECRET_TAG) &&
		(DUV1.dcache.wb.req_tag != miter.SECRET_TAG)
	);
endfunction

function automatic no_pending_secret_store_translated();
	no_pending_secret_store_translated = (
		(DUV1.lsu.stq_0_valid && DUV1.lsu.stq_0_bits_addr_valid && !DUV1.lsu.stq_0_bits_addr_is_virtual ? DUV1.lsu.stq_0_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_1_valid && DUV1.lsu.stq_1_bits_addr_valid && !DUV1.lsu.stq_1_bits_addr_is_virtual ? DUV1.lsu.stq_1_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_2_valid && DUV1.lsu.stq_2_bits_addr_valid && !DUV1.lsu.stq_2_bits_addr_is_virtual ? DUV1.lsu.stq_2_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_3_valid && DUV1.lsu.stq_3_bits_addr_valid && !DUV1.lsu.stq_3_bits_addr_is_virtual ? DUV1.lsu.stq_3_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_4_valid && DUV1.lsu.stq_4_bits_addr_valid && !DUV1.lsu.stq_4_bits_addr_is_virtual ? DUV1.lsu.stq_4_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_5_valid && DUV1.lsu.stq_5_bits_addr_valid && !DUV1.lsu.stq_5_bits_addr_is_virtual ? DUV1.lsu.stq_5_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_6_valid && DUV1.lsu.stq_6_bits_addr_valid && !DUV1.lsu.stq_6_bits_addr_is_virtual ? DUV1.lsu.stq_6_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_7_valid && DUV1.lsu.stq_7_bits_addr_valid && !DUV1.lsu.stq_7_bits_addr_is_virtual ? DUV1.lsu.stq_7_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_8_valid && DUV1.lsu.stq_8_bits_addr_valid && !DUV1.lsu.stq_8_bits_addr_is_virtual ? DUV1.lsu.stq_8_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_9_valid && DUV1.lsu.stq_9_bits_addr_valid && !DUV1.lsu.stq_9_bits_addr_is_virtual ? DUV1.lsu.stq_9_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_10_valid && DUV1.lsu.stq_10_bits_addr_valid && !DUV1.lsu.stq_10_bits_addr_is_virtual ? DUV1.lsu.stq_10_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_11_valid && DUV1.lsu.stq_11_bits_addr_valid && !DUV1.lsu.stq_11_bits_addr_is_virtual ? DUV1.lsu.stq_11_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_12_valid && DUV1.lsu.stq_12_bits_addr_valid && !DUV1.lsu.stq_12_bits_addr_is_virtual ? DUV1.lsu.stq_12_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_13_valid && DUV1.lsu.stq_13_bits_addr_valid && !DUV1.lsu.stq_13_bits_addr_is_virtual ? DUV1.lsu.stq_13_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_14_valid && DUV1.lsu.stq_14_bits_addr_valid && !DUV1.lsu.stq_14_bits_addr_is_virtual ? DUV1.lsu.stq_14_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV1.lsu.stq_15_valid && DUV1.lsu.stq_15_bits_addr_valid && !DUV1.lsu.stq_15_bits_addr_is_virtual ? DUV1.lsu.stq_15_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&

		(DUV2.lsu.stq_0_valid && DUV2.lsu.stq_0_bits_addr_valid && !DUV2.lsu.stq_0_bits_addr_is_virtual ? DUV2.lsu.stq_0_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.stq_1_valid && DUV2.lsu.stq_1_bits_addr_valid && !DUV2.lsu.stq_1_bits_addr_is_virtual ? DUV2.lsu.stq_1_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.stq_2_valid && DUV2.lsu.stq_2_bits_addr_valid && !DUV2.lsu.stq_2_bits_addr_is_virtual ? DUV2.lsu.stq_2_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.stq_3_valid && DUV2.lsu.stq_3_bits_addr_valid && !DUV2.lsu.stq_3_bits_addr_is_virtual ? DUV2.lsu.stq_3_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.stq_4_valid && DUV2.lsu.stq_4_bits_addr_valid && !DUV2.lsu.stq_4_bits_addr_is_virtual ? DUV2.lsu.stq_4_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.stq_5_valid && DUV2.lsu.stq_5_bits_addr_valid && !DUV2.lsu.stq_5_bits_addr_is_virtual ? DUV2.lsu.stq_5_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.stq_6_valid && DUV2.lsu.stq_6_bits_addr_valid && !DUV2.lsu.stq_6_bits_addr_is_virtual ? DUV2.lsu.stq_6_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
