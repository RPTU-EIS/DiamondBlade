		(DUV2.lsu.stq_10_valid && DUV2.lsu.stq_10_bits_addr_valid && !DUV2.lsu.stq_10_bits_addr_is_virtual ? DUV2.lsu.stq_10_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.stq_11_valid && DUV2.lsu.stq_11_bits_addr_valid && !DUV2.lsu.stq_11_bits_addr_is_virtual ? DUV2.lsu.stq_11_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.stq_12_valid && DUV2.lsu.stq_12_bits_addr_valid && !DUV2.lsu.stq_12_bits_addr_is_virtual ? DUV2.lsu.stq_12_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.stq_13_valid && DUV2.lsu.stq_13_bits_addr_valid && !DUV2.lsu.stq_13_bits_addr_is_virtual ? DUV2.lsu.stq_13_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.stq_14_valid && DUV2.lsu.stq_14_bits_addr_valid && !DUV2.lsu.stq_14_bits_addr_is_virtual ? DUV2.lsu.stq_14_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1) &&
		(DUV2.lsu.stq_15_valid && DUV2.lsu.stq_15_bits_addr_valid && !DUV2.lsu.stq_15_bits_addr_is_virtual ? DUV2.lsu.stq_15_bits_addr_bits[31:12] != miter.SECRET_TAG : 1'b1)
	);
endfunction

function automatic no_pending_secret_hella();
	no_pending_secret_hella = (
		(DUV1.lsu.hella_paddr[31:12] != miter.SECRET_TAG) &&
		(DUV2.lsu.hella_paddr[31:12] != miter.SECRET_TAG) &&
		(DUV1.lsu.hella_req_addr[31:12] != miter.SECRET_TAG) &&
		(DUV2.lsu.hella_req_addr[31:12] != miter.SECRET_TAG)
  );
endfunction

function automatic no_pending_secret_cache_access();
	no_pending_secret_cache_access = (
    (DUV1.dcache.s1_req_0_addr[31:12] != miter.SECRET_TAG) &&
    (DUV2.dcache.s1_req_0_addr[31:12] != miter.SECRET_TAG) &&
		(DUV1.dcache.s2_req_0_addr[31:12] != miter.SECRET_TAG) &&
		(DUV2.dcache.s2_req_0_addr[31:12] != miter.SECRET_TAG)
  );
endfunction

//else TLB exceptions are ignored
function automatic no_pending_lsu_exception();
	no_pending_lsu_exception = (
    (DUV1.core.io_lsu_exception_REG == 1'b0) &&
    (DUV2.core.io_lsu_exception_REG == 1'b0)
  );
endfunction

function automatic no_pending_secret_page_walk();
	no_pending_secret_page_walk = (
    (DUV1.ptw.r_pte_ppn[19:0] != miter.SECRET_TAG) &&
    (DUV2.ptw.r_pte_ppn[19:0] != miter.SECRET_TAG)
  );
endfunction

function automatic no_pending_secret_access();
	no_pending_secret_access = (
		no_secret_load_translated() &&
		no_pending_secret_replay() &&
		no_pending_secret_writeback() &&
		no_pending_secret_store_translated() &&
		no_pending_secret_hella() &&
		no_pending_secret_cache_access() &&
		no_pending_lsu_exception() &&
		no_pending_secret_page_walk()
	);
endfunction
