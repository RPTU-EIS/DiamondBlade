		DUV1.lsu.stq_5_bits_uop_uses_stq && (DUV1.lsu.stq_5_bits_uop_stq_idx == 4'h5) &&
		DUV1.lsu.stq_6_bits_uop_uses_stq && (DUV1.lsu.stq_6_bits_uop_stq_idx == 4'h6) &&
		DUV1.lsu.stq_7_bits_uop_uses_stq && (DUV1.lsu.stq_7_bits_uop_stq_idx == 4'h7) &&
		DUV1.lsu.stq_8_bits_uop_uses_stq && (DUV1.lsu.stq_8_bits_uop_stq_idx == 4'h8) &&
		DUV1.lsu.stq_9_bits_uop_uses_stq && (DUV1.lsu.stq_9_bits_uop_stq_idx == 4'h9) &&
		DUV1.lsu.stq_10_bits_uop_uses_stq && (DUV1.lsu.stq_10_bits_uop_stq_idx == 4'ha) &&
		DUV1.lsu.stq_11_bits_uop_uses_stq && (DUV1.lsu.stq_11_bits_uop_stq_idx == 4'hb) &&
		DUV1.lsu.stq_12_bits_uop_uses_stq && (DUV1.lsu.stq_12_bits_uop_stq_idx == 4'hc) &&
		DUV1.lsu.stq_13_bits_uop_uses_stq && (DUV1.lsu.stq_13_bits_uop_stq_idx == 4'hd) &&
		DUV1.lsu.stq_14_bits_uop_uses_stq && (DUV1.lsu.stq_14_bits_uop_stq_idx == 4'he) &&
		DUV1.lsu.stq_15_bits_uop_uses_stq && (DUV1.lsu.stq_15_bits_uop_stq_idx == 4'hf) &&
    DUV2.lsu.stq_0_bits_uop_uses_stq && (DUV2.lsu.stq_0_bits_uop_stq_idx == 4'h0) &&
		DUV2.lsu.stq_1_bits_uop_uses_stq && (DUV2.lsu.stq_1_bits_uop_stq_idx == 4'h1) &&
		DUV2.lsu.stq_2_bits_uop_uses_stq && (DUV2.lsu.stq_2_bits_uop_stq_idx == 4'h2) &&
		DUV2.lsu.stq_3_bits_uop_uses_stq && (DUV2.lsu.stq_3_bits_uop_stq_idx == 4'h3) &&
		DUV2.lsu.stq_4_bits_uop_uses_stq && (DUV2.lsu.stq_4_bits_uop_stq_idx == 4'h4) &&
		DUV2.lsu.stq_5_bits_uop_uses_stq && (DUV2.lsu.stq_5_bits_uop_stq_idx == 4'h5) &&
		DUV2.lsu.stq_6_bits_uop_uses_stq && (DUV2.lsu.stq_6_bits_uop_stq_idx == 4'h6) &&
		DUV2.lsu.stq_7_bits_uop_uses_stq && (DUV2.lsu.stq_7_bits_uop_stq_idx == 4'h7) &&
		DUV2.lsu.stq_8_bits_uop_uses_stq && (DUV2.lsu.stq_8_bits_uop_stq_idx == 4'h8) &&
		DUV2.lsu.stq_9_bits_uop_uses_stq && (DUV2.lsu.stq_9_bits_uop_stq_idx == 4'h9) &&
		DUV2.lsu.stq_10_bits_uop_uses_stq && (DUV2.lsu.stq_10_bits_uop_stq_idx == 4'ha) &&
		DUV2.lsu.stq_11_bits_uop_uses_stq && (DUV2.lsu.stq_11_bits_uop_stq_idx == 4'hb) &&
		DUV2.lsu.stq_12_bits_uop_uses_stq && (DUV2.lsu.stq_12_bits_uop_stq_idx == 4'hc) &&
		DUV2.lsu.stq_13_bits_uop_uses_stq && (DUV2.lsu.stq_13_bits_uop_stq_idx == 4'hd) &&
		DUV2.lsu.stq_14_bits_uop_uses_stq && (DUV2.lsu.stq_14_bits_uop_stq_idx == 4'he) &&
		DUV2.lsu.stq_15_bits_uop_uses_stq && (DUV2.lsu.stq_15_bits_uop_stq_idx == 4'hf)
	);
endfunction

