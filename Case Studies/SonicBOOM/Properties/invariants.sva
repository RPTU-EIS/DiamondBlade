function automatic stq_committed_implies_physical_address();
	stq_committed_implies_physical_address = (
		(DUV1.lsu.stq_0_bits_committed ? !DUV1.lsu.stq_0_bits_addr_is_virtual && DUV1.lsu.stq_0_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_1_bits_committed ? !DUV1.lsu.stq_1_bits_addr_is_virtual && DUV1.lsu.stq_1_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_2_bits_committed ? !DUV1.lsu.stq_2_bits_addr_is_virtual && DUV1.lsu.stq_2_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_3_bits_committed ? !DUV1.lsu.stq_3_bits_addr_is_virtual && DUV1.lsu.stq_3_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_4_bits_committed ? !DUV1.lsu.stq_4_bits_addr_is_virtual && DUV1.lsu.stq_4_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_5_bits_committed ? !DUV1.lsu.stq_5_bits_addr_is_virtual && DUV1.lsu.stq_5_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_6_bits_committed ? !DUV1.lsu.stq_6_bits_addr_is_virtual && DUV1.lsu.stq_6_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_7_bits_committed ? !DUV1.lsu.stq_7_bits_addr_is_virtual && DUV1.lsu.stq_7_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_8_bits_committed ? !DUV1.lsu.stq_8_bits_addr_is_virtual && DUV1.lsu.stq_8_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_9_bits_committed ? !DUV1.lsu.stq_9_bits_addr_is_virtual && DUV1.lsu.stq_9_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_10_bits_committed ? !DUV1.lsu.stq_10_bits_addr_is_virtual && DUV1.lsu.stq_10_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_11_bits_committed ? !DUV1.lsu.stq_11_bits_addr_is_virtual && DUV1.lsu.stq_11_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_12_bits_committed ? !DUV1.lsu.stq_12_bits_addr_is_virtual && DUV1.lsu.stq_12_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_13_bits_committed ? !DUV1.lsu.stq_13_bits_addr_is_virtual && DUV1.lsu.stq_13_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_14_bits_committed ? !DUV1.lsu.stq_14_bits_addr_is_virtual && DUV1.lsu.stq_14_bits_addr_valid : 1'b1) &&
		(DUV1.lsu.stq_15_bits_committed ? !DUV1.lsu.stq_15_bits_addr_is_virtual && DUV1.lsu.stq_15_bits_addr_valid : 1'b1) &&

		(DUV2.lsu.stq_0_bits_committed ? !DUV2.lsu.stq_0_bits_addr_is_virtual && DUV2.lsu.stq_0_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_1_bits_committed ? !DUV2.lsu.stq_1_bits_addr_is_virtual && DUV2.lsu.stq_1_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_2_bits_committed ? !DUV2.lsu.stq_2_bits_addr_is_virtual && DUV2.lsu.stq_2_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_3_bits_committed ? !DUV2.lsu.stq_3_bits_addr_is_virtual && DUV2.lsu.stq_3_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_4_bits_committed ? !DUV2.lsu.stq_4_bits_addr_is_virtual && DUV2.lsu.stq_4_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_5_bits_committed ? !DUV2.lsu.stq_5_bits_addr_is_virtual && DUV2.lsu.stq_5_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_6_bits_committed ? !DUV2.lsu.stq_6_bits_addr_is_virtual && DUV2.lsu.stq_6_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_7_bits_committed ? !DUV2.lsu.stq_7_bits_addr_is_virtual && DUV2.lsu.stq_7_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_8_bits_committed ? !DUV2.lsu.stq_8_bits_addr_is_virtual && DUV2.lsu.stq_8_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_9_bits_committed ? !DUV2.lsu.stq_9_bits_addr_is_virtual && DUV2.lsu.stq_9_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_10_bits_committed ? !DUV2.lsu.stq_10_bits_addr_is_virtual && DUV2.lsu.stq_10_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_11_bits_committed ? !DUV2.lsu.stq_11_bits_addr_is_virtual && DUV2.lsu.stq_11_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_12_bits_committed ? !DUV2.lsu.stq_12_bits_addr_is_virtual && DUV2.lsu.stq_12_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_13_bits_committed ? !DUV2.lsu.stq_13_bits_addr_is_virtual && DUV2.lsu.stq_13_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_14_bits_committed ? !DUV2.lsu.stq_14_bits_addr_is_virtual && DUV2.lsu.stq_14_bits_addr_valid : 1'b1) &&
		(DUV2.lsu.stq_15_bits_committed ? !DUV2.lsu.stq_15_bits_addr_is_virtual && DUV2.lsu.stq_15_bits_addr_valid : 1'b1)
	);
endfunction

function automatic stq_uses_stq_and_consistent_stq_idx();
	stq_uses_stq_and_consistent_stq_idx = (
		DUV1.lsu.stq_0_bits_uop_uses_stq && (DUV1.lsu.stq_0_bits_uop_stq_idx == 4'h0) &&
		DUV1.lsu.stq_1_bits_uop_uses_stq && (DUV1.lsu.stq_1_bits_uop_stq_idx == 4'h1) &&
		DUV1.lsu.stq_2_bits_uop_uses_stq && (DUV1.lsu.stq_2_bits_uop_stq_idx == 4'h2) &&
