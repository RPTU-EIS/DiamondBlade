module DB_AIP_fw_cycle1(clock, reset);
input clock;
input reset;


`include "blackboxing.sva"

`include "symbolic_pmp.sva"
function automatic threat_model_global();
	threat_model_global = pmp_enabled();
endfunction

`include "no_pending_secret_access.sva"
function automatic threat_model_start();
	threat_model_start = no_pending_secret_access();
endfunction

`include "invariants.sva"
function automatic invariants();
	invariants = (
		stq_committed_implies_physical_address() &&
		stq_uses_stq_and_consistent_stq_idx() &&
		ldq_uses_ldq_and_consistent_ldq_idx() &&
		exe_tlb_uop_mem_cmd_consistent() &&
		equal_paddr_on_hit() &&
		exe_tlb_uop() &&
		no_unprotected_dtlb_entry() &&
		exe_tlb_uop_store_not_translated() &&
		satp_ppn_not_secret() &&
		stq_succeeded_implies_committed() &&
		s1_hella_req_not_secret() &&
		exe_tlb_uop_load_br_mask_consistent()
);endfunction

invariant_assumption: assume property(@(posedge clock) disable iff(reset==1) invariants());

property symbolic_secret_address;
	$past(miter.SECRET_ADDR) == miter.SECRET_ADDR;
	//miter.SECRET_ADDR == 32'h8abcde00;
endproperty

symbolic_address_constraint: assume property( @ (posedge clock) symbolic_secret_address);

property privilege_mode_user_or_supervisor;
	(DUV1.core.csr.io_status_dprv < 2'd2) && 
	(DUV2.core.csr.io_status_dprv < 2'd2);
endproperty

privilege_mode_constraint: assume property( @ (posedge clock) disable iff(reset == 1) privilege_mode_user_or_supervisor);


//System Verilog library for TiDAL
`include "tidal.sv"

//TiDAL properties must be enclosed within begin_tda and end_tda macros
`begin_tda(tda)

function automatic input_equivalence_except_src();
	input_equivalence_except_src = (
		(DUV1.frontend.fb.io_deq_bits_uops_1_bits_bp_debug_if == DUV2.frontend.fb.io_deq_bits_uops_1_bits_bp_debug_if) &&
