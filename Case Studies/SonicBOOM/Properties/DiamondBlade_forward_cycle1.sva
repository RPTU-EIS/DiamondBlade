		(DUV1.ptw.r_req_addr == DUV2.ptw.r_req_addr) &&
		(DUV1.ptw.r_req_dest == DUV2.ptw.r_req_dest) &&
		(DUV1.ptw.r_req_need_gpa == DUV2.ptw.r_req_need_gpa) &&
		(DUV1.ptw.resp_ae_final == DUV2.ptw.resp_ae_final) &&
		(DUV1.ptw.resp_ae_ptw == DUV2.ptw.resp_ae_ptw) &&
		(DUV1.ptw.resp_valid_0 == DUV2.ptw.resp_valid_0) &&
		(DUV1.ptw.resp_valid_1 == DUV2.ptw.resp_valid_1) &&
		(DUV1.ptw.s1_valid == DUV2.ptw.s1_valid) &&
		(DUV1.ptw.s2_g_vec_0 == DUV2.ptw.s2_g_vec_0) &&
		(DUV1.ptw.s2_valid == DUV2.ptw.s2_valid) &&
		(DUV1.ptw.s2_valid_vec == DUV2.ptw.s2_valid_vec) &&
		(DUV1.ptw.state == DUV2.ptw.state) &&
		(DUV1.ptw.state_reg == DUV2.ptw.state_reg) &&
		(DUV1.ptw.tags__0 == DUV2.ptw.tags__0) &&
		(DUV1.ptw.tags__1 == DUV2.ptw.tags__1) &&
		(DUV1.ptw.tags__2 == DUV2.ptw.tags__2) &&
		(DUV1.ptw.tags__3 == DUV2.ptw.tags__3) &&
		(DUV1.ptw.tags__4 == DUV2.ptw.tags__4) &&
		(DUV1.ptw.tags__5 == DUV2.ptw.tags__5) &&
		(DUV1.ptw.tags__6 == DUV2.ptw.tags__6) &&
		(DUV1.ptw.tags__7 == DUV2.ptw.tags__7) &&
		(DUV1.ptw.valid == DUV2.ptw.valid) &&
		(DUV1.ptw.valid_2_0 == DUV2.ptw.valid_2_0) &&
		(DUV1.tlMasterXbar.beatsLeft == DUV2.tlMasterXbar.beatsLeft) &&
		(DUV1.tlMasterXbar.readys_mask == DUV2.tlMasterXbar.readys_mask) &&
		(DUV1.tlMasterXbar.state_0 == DUV2.tlMasterXbar.state_0) &&
		(DUV1.tlMasterXbar.state_1 == DUV2.tlMasterXbar.state_1)
	);
endfunction

function automatic state_equivalence_except_src();
	state_equivalence_except_src = (
		state_equivalence_except_src_0() &&
		state_equivalence_except_src_1() &&
		state_equivalence_except_src_2() &&
		state_equivalence_except_src_3() &&
		state_equivalence_except_src_4() &&
		state_equivalence_except_src_5() &&
		state_equivalence_except_src_6() &&
		state_equivalence_except_src_7()
	);
endfunction


property DiamondBlade_forward_dcache$data$io_resp_0_0_REG_cycle1;

	during_o(t, 0, t, 2, blackboxing()) and
	during_o(t, 0, t, 1, state_equivalence_except_src()) and
	during_o(t, 0, t, 2, input_equivalence_except_src()) and
	during_o(t, 0, t, 2, threat_model_global()) and
	t ##0 threat_model_start()

implies

	t ##2 DUV1.dcache.data.io_resp_0_0_REG == DUV2.dcache.data.io_resp_0_0_REG;

endproperty

